<div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden group flex flex-col">
  <a href="/product/<%= product.slug %>" class="block">
    <div class="aspect-square overflow-hidden bg-gray-100 relative">
      <% if (product.images && product.images.length) { %>
      <img src="<%= product.images[0] %>" alt="<%= product.name %>" loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
      <% } else { %>
      <div class="w-full h-full flex items-center justify-center text-gray-300">
        <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      </div>
      <% } %>
      <% if (product.discountPrice && product.price) { %>
      <span class="absolute top-2 left-2 bg-rose-600 text-white text-xs font-bold px-1.5 py-0.5 rounded">
        -<%= Math.round((1 - product.discountPrice / product.price) * 100) %>%
      </span>
      <% } %>
    </div>
    <div class="p-3 flex-1">
      <h3 class="text-sm font-medium text-gray-800 line-clamp-2 mb-1.5 leading-snug"><%= product.name %></h3>
      <div class="flex items-center gap-2">
        <% if (product.discountPrice) { %>
        <span class="text-rose-600 font-bold text-sm">৳ <%= product.discountPrice %></span>
        <span class="text-gray-400 text-xs line-through">৳ <%= product.price %></span>
        <% } else { %>
        <span class="text-rose-600 font-bold text-sm">৳ <%= product.price %></span>
        <% } %>
      </div>
    </div>
  </a>
  <div class="px-3 pb-3 flex flex-col gap-1.5 mt-auto">
    <button onclick="buyNow('<%= product._id %>', 1, this)"
      class="w-full bg-rose-600 hover:bg-rose-700 active:bg-rose-800 text-white text-xs font-semibold py-2 rounded-lg transition-colors">
      এখনই অর্ডার করুন
    </button>
    <button onclick="addToCart('<%= product._id %>', 1, this)"
      class="w-full bg-white hover:bg-rose-50 text-rose-600 border border-rose-300 text-xs font-medium py-1.5 rounded-lg transition-colors">
      + কার্টে যোগ করুন
    </button>
  </div>
</div>
