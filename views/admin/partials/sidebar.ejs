<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — ' : '' %>Admin · খুচরা বাজার</title>
  <link rel="stylesheet" href="/css/output.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>
    [x-cloak]{display:none!important}
    body{font-family:'Inter',ui-sans-serif,system-ui,sans-serif}
    .nav-active{background:linear-gradient(135deg,#e11d48,#be123c);color:#fff;box-shadow:0 2px 8px rgba(225,29,72,.35)}
    .stat-icon{display:flex;align-items:center;justify-content:center;width:2.75rem;height:2.75rem;border-radius:.875rem;flex-shrink:0}
    .pill-pending   {background:#fef3c7;color:#92400e;border:1px solid #fde68a}
    .pill-confirmed {background:#dbeafe;color:#1e40af;border:1px solid #bfdbfe}
    .pill-shipped   {background:#ede9fe;color:#5b21b6;border:1px solid #ddd6fe}
    .pill-delivered {background:#d1fae5;color:#065f46;border:1px solid #a7f3d0}
    .pill-cancelled {background:#fee2e2;color:#991b1b;border:1px solid #fecaca}
    .pill-active    {background:#d1fae5;color:#065f46;border:1px solid #a7f3d0}
    .pill-inactive  {background:#f3f4f6;color:#6b7280;border:1px solid #e5e7eb}
    .tab-inactive   {background:#fff;color:#6b7280;border:1px solid #d1d5db;border-radius:.5rem;transition:background .15s,color .15s}
    .tab-inactive:hover{background:#f9fafb;color:#374151}
  </style>
</head>
<body class="bg-slate-50 antialiased" x-data="{ open: false }">
<div class="flex min-h-screen">

  <!-- Mobile overlay -->
  <div @click="open=false" x-show="open" x-cloak
    class="fixed inset-0 bg-black/40 backdrop-blur-sm z-40 lg:hidden" x-transition.opacity></div>

  <!-- Sidebar -->
  <aside :class="open?'translate-x-0':'-translate-x-full'"
    class="fixed lg:static lg:translate-x-0 z-50 w-60 bg-slate-900 min-h-screen flex flex-col shrink-0 transition-transform duration-200">

    <!-- Logo -->
    <div class="px-4 py-5">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-rose-500 to-rose-700 flex items-center justify-center shrink-0 shadow-lg shadow-rose-900/40">
          <span class="text-white font-bold text-sm leading-none select-none">খ</span>
        </div>
        <div>
          <p class="text-white font-semibold text-sm leading-snug">খুচরা বাজার</p>
          <p class="text-slate-500 text-xs">Admin Dashboard</p>
        </div>
      </div>
    </div>

    <div class="mx-4 border-t border-slate-800"></div>

    <!-- Navigation -->
    <nav class="flex-1 p-3 mt-2 space-y-0.5">

      <p class="text-slate-600 text-[10px] font-semibold uppercase tracking-widest px-3 mb-2">Main</p>

      <a href="/admin" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all <%= pageTitle==='Dashboard' ? 'nav-active' : 'text-slate-400 hover:bg-slate-800 hover:text-white' %>">
        <svg class="w-4.5 h-4.5 w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" stroke-width="1.75"/><rect x="14" y="3" width="7" height="7" rx="1.5" stroke-width="1.75"/><rect x="3" y="14" width="7" height="7" rx="1.5" stroke-width="1.75"/><rect x="14" y="14" width="7" height="7" rx="1.5" stroke-width="1.75"/></svg>
        Dashboard
      </a>

      <a href="/admin/orders" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all <%= pageTitle==='Orders'||pageTitle&&pageTitle.startsWith('Order ') ? 'nav-active' : 'text-slate-400 hover:bg-slate-800 hover:text-white' %>">
        <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
        Orders
      </a>

      <a href="/admin/products" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all <%= pageTitle==='Products'||pageTitle==='New Product'||pageTitle==='Edit Product' ? 'nav-active' : 'text-slate-400 hover:bg-slate-800 hover:text-white' %>">
        <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        Products
      </a>

      <a href="/admin/categories" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all <%= pageTitle==='Categories' ? 'nav-active' : 'text-slate-400 hover:bg-slate-800 hover:text-white' %>">
        <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
        Categories
      </a>

      <div class="pt-3 pb-1">
        <div class="mx-0 border-t border-slate-800"></div>
        <p class="text-slate-600 text-[10px] font-semibold uppercase tracking-widest px-3 mt-3 mb-2">Config</p>
      </div>

      <a href="/admin/settings" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all <%= pageTitle==='Settings' ? 'nav-active' : 'text-slate-400 hover:bg-slate-800 hover:text-white' %>">
        <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Settings
      </a>
    </nav>

    <!-- Sidebar footer -->
    <div class="p-3 pb-5 space-y-0.5">
      <div class="border-t border-slate-800 mb-3"></div>
      <a href="/" target="_blank" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-500 hover:bg-slate-800 hover:text-white transition-all">
        <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        View Store
      </a>
      <button onclick="document.cookie='admin_token=;path=/;max-age=0';window.location.href='/admin/login'"
        class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-500 hover:bg-red-900/60 hover:text-red-300 transition-all w-full text-left">
        <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        Logout
      </button>
    </div>
  </aside>

  <!-- Main wrapper -->
  <div class="flex-1 flex flex-col min-w-0">

    <!-- Top bar -->
    <header class="bg-white/80 backdrop-blur border-b border-gray-200 px-6 py-3 flex items-center justify-between sticky top-0 z-30">
      <div class="flex items-center gap-3">
        <button @click="open=true" class="lg:hidden p-1.5 rounded-lg text-gray-500 hover:bg-gray-100 -ml-1.5">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <% if(typeof pageTitle!=='undefined'){ %>
          <nav class="flex items-center gap-2 text-sm">
            <a href="/admin" class="text-gray-400 hover:text-gray-700 transition-colors">Admin</a>
            <% if(pageTitle!=='Dashboard'){ %>
              <span class="text-gray-300 select-none">/</span>
              <span class="text-gray-700 font-semibold"><%= pageTitle %></span>
            <% } else { %>
              <span class="text-gray-700 font-semibold">Dashboard</span>
            <% } %>
          </nav>
        <% } %>
      </div>
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-rose-400 to-rose-600 flex items-center justify-center shadow-sm">
          <span class="text-white text-xs font-bold">A</span>
        </div>
      </div>
    </header>

    <!-- Page content -->
    <main class="flex-1 p-6">
