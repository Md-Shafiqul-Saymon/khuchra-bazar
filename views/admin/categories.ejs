<%- include('partials/sidebar', { pageTitle: 'Categories' }) %>

<div x-data="categoryManager()">

  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-xl font-bold text-gray-900">Categories</h1>
      <p class="text-sm text-gray-400 mt-0.5"><%= categories.length %> categories</p>
    </div>
    <button @click="showForm = true; editId = null; form = { name: '', slug: '', image: '' }"
      class="inline-flex items-center gap-2 bg-rose-600 hover:bg-rose-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors shadow-sm shadow-rose-200">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
      Add Category
    </button>
  </div>

  <!-- Add/Edit form -->
  <template x-if="showForm">
    <div class="bg-white rounded-2xl ring-1 ring-black/5 shadow-sm p-6 mb-5">
      <h2 class="font-semibold text-gray-800 mb-4" x-text="editId ? 'Edit Category' : 'New Category'"></h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Name *</label>
          <input type="text" x-model="form.name" placeholder="Category name"
            class="w-full border border-gray-200 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-rose-400 focus:ring-2 focus:ring-rose-100 transition-all">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Slug</label>
          <input type="text" x-model="form.slug" placeholder="auto-generated"
            class="w-full border border-gray-200 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-rose-400 focus:ring-2 focus:ring-rose-100 transition-all font-mono">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Image URL</label>
          <input type="text" x-model="form.image" placeholder="/uploads/... or https://..."
            class="w-full border border-gray-200 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-rose-400 focus:ring-2 focus:ring-rose-100 transition-all">
        </div>
      </div>
      <div class="flex gap-2">
        <button @click="saveCategory()"
          class="bg-rose-600 hover:bg-rose-700 text-white px-5 py-2.5 rounded-xl text-sm font-semibold transition-colors">
          <span x-text="editId ? 'Update Category' : 'Create Category'"></span>
        </button>
        <button @click="showForm = false; editId = null"
          class="bg-gray-100 hover:bg-gray-200 text-gray-600 px-5 py-2.5 rounded-xl text-sm font-medium transition-colors">
          Cancel
        </button>
      </div>
    </div>
  </template>

  <!-- Categories table -->
  <div class="bg-white rounded-2xl ring-1 ring-black/5 shadow-sm overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-100">
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide w-16">Image</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Name</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide hidden sm:table-cell">Slug</th>
          <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wide">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <% categories.forEach(function(cat){ %>
        <tr class="hover:bg-slate-50/60 transition-colors">
          <td class="px-4 py-3">
            <% if(cat.image){ %>
              <img src="<%= cat.image %>" alt="" class="w-10 h-10 rounded-xl object-cover ring-1 ring-black/5">
            <% } else { %>
              <div class="w-10 h-10 rounded-xl bg-gray-100 flex items-center justify-center">
                <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
              </div>
            <% } %>
          </td>
          <td class="px-4 py-3">
            <p class="font-semibold text-gray-800"><%= cat.name %></p>
          </td>
          <td class="px-4 py-3 hidden sm:table-cell">
            <span class="text-xs text-gray-400 font-mono bg-gray-50 px-2 py-1 rounded-lg"><%= cat.slug %></span>
          </td>
          <td class="px-4 py-3 text-right">
            <div class="flex items-center justify-end gap-1.5">
              <button @click="editCategory(<%- JSON.stringify(cat) %>)"
                class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-700 bg-blue-50 hover:bg-blue-100 px-3 py-1.5 rounded-lg transition-colors">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                Edit
              </button>
              <button @click="deleteCategory('<%= cat._id %>')"
                class="inline-flex items-center gap-1 text-xs font-semibold text-red-500 hover:text-red-600 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-lg transition-colors">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                Delete
              </button>
            </div>
          </td>
        </tr>
        <% }); %>
        <% if(!categories.length){ %>
        <tr>
          <td colspan="4" class="px-4 py-16 text-center">
            <div class="flex flex-col items-center gap-3 text-gray-300">
              <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
              <p class="text-sm font-medium text-gray-400">No categories yet</p>
            </div>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>

</div>

<%- include('partials/end') %>
