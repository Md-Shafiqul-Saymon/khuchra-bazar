<%- include('partials/sidebar', { pageTitle: 'Products' }) %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-bold text-gray-900">Products</h1>
    <p class="text-sm text-gray-400 mt-0.5"><%= total %> products</p>
  </div>
  <a href="/admin/products/new"
    class="inline-flex items-center gap-2 bg-rose-600 hover:bg-rose-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors shadow-sm shadow-rose-200">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
    Add Product
  </a>
</div>

<div class="bg-white rounded-2xl ring-1 ring-black/5 shadow-sm overflow-hidden">

  <!-- Search bar -->
  <div class="p-4 border-b border-gray-100">
    <form action="/admin/products" method="GET" class="flex gap-2.5">
      <div class="relative flex-1">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input type="text" name="search" value="<%= search || '' %>" placeholder="Search products..."
          class="w-full pl-9 pr-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-rose-400 focus:ring-2 focus:ring-rose-100 transition-all">
      </div>
      <button type="submit" class="bg-gray-900 hover:bg-gray-800 text-white px-5 py-2.5 rounded-xl text-sm font-medium transition-colors">Search</button>
      <% if(search){ %>
        <a href="/admin/products" class="px-4 py-2.5 rounded-xl text-sm text-gray-500 hover:bg-gray-100 transition-colors border border-gray-200">Clear</a>
      <% } %>
    </form>
  </div>

  <!-- Table -->
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-100">
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide w-16">Image</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Product</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide hidden sm:table-cell">Category</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Price</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide hidden md:table-cell">Stock</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Status</th>
          <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wide">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <% products.forEach(function(product){ %>
        <tr class="hover:bg-slate-50/60 transition-colors group">
          <!-- Thumbnail -->
          <td class="px-4 py-3">
            <% if(product.images && product.images.length){ %>
              <img src="<%= product.images[0] %>" alt=""
                class="w-12 h-12 rounded-xl object-cover ring-1 ring-black/5">
            <% } else { %>
              <div class="w-12 h-12 rounded-xl bg-gray-100 flex items-center justify-center">
                <svg class="w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
            <% } %>
          </td>
          <!-- Name + slug -->
          <td class="px-4 py-3">
            <div>
              <p class="font-semibold text-gray-800 line-clamp-1 text-sm"><%= product.name %></p>
              <p class="text-xs text-gray-400 mt-0.5 font-mono"><%= product.slug %></p>
              <!-- Badges inline -->
              <div class="flex gap-1 mt-1.5">
                <% if(product.isFlashSale){ %>
                  <span class="text-[10px] font-bold bg-amber-100 text-amber-700 border border-amber-200 px-1.5 py-0.5 rounded-md">⚡ FLASH</span>
                <% } %>
                <% if(product.isFeatured){ %>
                  <span class="text-[10px] font-bold bg-blue-100 text-blue-700 border border-blue-200 px-1.5 py-0.5 rounded-md">★ FEATURED</span>
                <% } %>
                <% if(product.images && product.images.length > 1){ %>
                  <span class="text-[10px] text-gray-400 bg-gray-100 px-1.5 py-0.5 rounded-md"><%= product.images.length %> photos</span>
                <% } %>
              </div>
            </div>
          </td>
          <!-- Category -->
          <td class="px-4 py-3 hidden sm:table-cell">
            <% if(product.category && product.category.name){ %>
              <span class="text-xs bg-gray-100 text-gray-600 px-2.5 py-1 rounded-full font-medium"><%= product.category.name %></span>
            <% } else { %>
              <span class="text-xs text-gray-300">—</span>
            <% } %>
          </td>
          <!-- Price -->
          <td class="px-4 py-3">
            <% if(product.discountPrice){ %>
              <p class="font-bold text-rose-600 text-sm">৳ <%= product.discountPrice.toLocaleString() %></p>
              <p class="text-xs text-gray-400 line-through">৳ <%= product.price.toLocaleString() %></p>
              <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-1 rounded">
                <%= Math.round((1 - product.discountPrice/product.price)*100) %>% off
              </span>
            <% } else { %>
              <p class="font-semibold text-gray-800 text-sm">৳ <%= product.price.toLocaleString() %></p>
            <% } %>
          </td>
          <!-- Stock -->
          <td class="px-4 py-3 hidden md:table-cell">
            <span class="text-sm font-medium <%= product.stock < 10 ? 'text-red-600' : 'text-gray-700' %>">
              <%= product.stock %>
            </span>
            <% if(product.stock < 10 && product.stock > 0){ %>
              <p class="text-[10px] text-red-500 font-medium">Low stock</p>
            <% } %>
          </td>
          <!-- Status -->
          <td class="px-4 py-3">
            <span class="text-xs pill-<%= product.status %> px-2.5 py-1 rounded-full font-semibold">
              <%= product.status.charAt(0).toUpperCase() + product.status.slice(1) %>
            </span>
          </td>
          <!-- Actions -->
          <td class="px-4 py-3 text-right">
            <div class="flex items-center justify-end gap-1.5">
              <a href="/admin/products/<%= product._id %>/edit"
                class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-700 bg-blue-50 hover:bg-blue-100 px-3 py-1.5 rounded-lg transition-colors">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                Edit
              </a>
              <button onclick="deleteProduct('<%= product._id %>')"
                class="inline-flex items-center gap-1 text-xs font-semibold text-red-500 hover:text-red-600 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-lg transition-colors">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                Del
              </button>
            </div>
          </td>
        </tr>
        <% }); %>
        <% if(!products.length){ %>
        <tr>
          <td colspan="7" class="px-4 py-16 text-center">
            <div class="flex flex-col items-center gap-3 text-gray-300">
              <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
              <p class="text-sm font-medium text-gray-400"><%= search ? 'No products match your search' : 'No products yet' %></p>
              <a href="/admin/products/new" class="text-xs text-rose-600 hover:underline font-medium">Add your first product →</a>
            </div>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if(pages > 1){ %>
  <div class="flex items-center justify-between px-4 py-3 border-t border-gray-100">
    <p class="text-xs text-gray-400">Page <%= page %> of <%= pages %></p>
    <div class="flex gap-1">
      <% if(page > 1){ %>
        <a href="/admin/products?page=<%= page-1 %><%= search ? '&search='+encodeURIComponent(search) : '' %>"
          class="px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-100 hover:bg-gray-200 text-gray-600 transition-colors">← Prev</a>
      <% } %>
      <% for(let i=Math.max(1,page-2); i<=Math.min(pages,page+2); i++){ %>
        <a href="/admin/products?page=<%= i %><%= search ? '&search='+encodeURIComponent(search) : '' %>"
          class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors
            <%= i===page ? 'bg-rose-600 text-white shadow-sm' : 'bg-gray-100 hover:bg-gray-200 text-gray-600' %>"><%= i %></a>
      <% } %>
      <% if(page < pages){ %>
        <a href="/admin/products?page=<%= page+1 %><%= search ? '&search='+encodeURIComponent(search) : '' %>"
          class="px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-100 hover:bg-gray-200 text-gray-600 transition-colors">Next →</a>
      <% } %>
    </div>
  </div>
  <% } %>
</div>

<%- include('partials/end') %>
