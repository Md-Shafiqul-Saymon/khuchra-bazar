<%- include('partials/sidebar', { pageTitle: 'Dashboard' }) %>

<%
  const fulfilled = stats.deliveredOrders;
  const actionable = stats.totalOrders - stats.cancelledOrders;
  const fulfillmentRate = actionable > 0 ? Math.round((fulfilled / actionable) * 100) : 0;
  const cancellationRate = stats.totalOrders > 0 ? Math.round((stats.cancelledOrders / stats.totalOrders) * 100) : 0;
%>

<div x-data="dashboard()" x-init="init()">

  <!-- Page header -->
  <div class="flex items-center justify-between mb-7">
    <div>
      <h1 class="text-xl font-bold text-gray-900">Good day 👋</h1>
      <p class="text-sm text-gray-400 mt-0.5" x-text="today"></p>
    </div>
    <a href="/admin/orders?status=pending"
      class="inline-flex items-center gap-2 bg-amber-50 hover:bg-amber-100 border border-amber-200 text-amber-800 text-sm font-medium px-4 py-2 rounded-xl transition-colors">
      <span class="w-2 h-2 bg-amber-500 rounded-full animate-pulse"></span>
      <%= stats.pendingOrders %> pending
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
  </div>

  <!-- ── Row 1: 4 Primary KPI cards ── -->
  <div class="grid grid-cols-2 xl:grid-cols-4 gap-4 mb-5">

    <!-- Total Revenue -->
    <div class="bg-white rounded-2xl p-5 ring-1 ring-black/5 shadow-sm">
      <div class="flex items-start justify-between mb-4">
        <div class="stat-icon bg-rose-50">
          <svg class="w-5 h-5 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <span class="text-xs text-gray-400 bg-gray-50 px-2 py-1 rounded-lg">All time</span>
      </div>
      <p class="text-2xl font-bold text-gray-900 tracking-tight">৳ <%= stats.totalRevenue.toLocaleString() %></p>
      <p class="text-sm text-gray-400 mt-1">Total Revenue</p>
    </div>

    <!-- This Month -->
    <div class="bg-white rounded-2xl p-5 ring-1 ring-black/5 shadow-sm">
      <div class="flex items-start justify-between mb-4">
        <div class="stat-icon bg-blue-50">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
        <span class="text-xs text-gray-400 bg-gray-50 px-2 py-1 rounded-lg"><%= stats.thisMonthOrders %> orders</span>
      </div>
      <p class="text-2xl font-bold text-gray-900 tracking-tight">৳ <%= stats.thisMonthRevenue.toLocaleString() %></p>
      <p class="text-sm text-gray-400 mt-1">This Month</p>
    </div>

    <!-- Today -->
    <div class="bg-white rounded-2xl p-5 ring-1 ring-black/5 shadow-sm">
      <div class="flex items-start justify-between mb-4">
        <div class="stat-icon bg-emerald-50">
          <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
        </div>
        <span class="text-xs text-gray-400 bg-gray-50 px-2 py-1 rounded-lg"><%= stats.todayOrders %> orders</span>
      </div>
      <p class="text-2xl font-bold text-gray-900 tracking-tight">৳ <%= stats.todayRevenue.toLocaleString() %></p>
      <p class="text-sm text-gray-400 mt-1">Today</p>
    </div>

    <!-- Avg Order Value -->
    <div class="bg-white rounded-2xl p-5 ring-1 ring-black/5 shadow-sm">
      <div class="flex items-start justify-between mb-4">
        <div class="stat-icon bg-violet-50">
          <svg class="w-5 h-5 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        </div>
        <span class="text-xs text-gray-400 bg-gray-50 px-2 py-1 rounded-lg"><%= productCount %> products</span>
      </div>
      <p class="text-2xl font-bold text-gray-900 tracking-tight">৳ <%= stats.avgOrderValue.toLocaleString() %></p>
      <p class="text-sm text-gray-400 mt-1">Avg Order Value</p>
    </div>
  </div>

  <!-- ── Row 2: Order Pipeline ── -->
  <div class="bg-white rounded-2xl ring-1 ring-black/5 shadow-sm p-5 mb-5">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-semibold text-gray-800 text-sm">Order Pipeline</h2>
      <span class="text-xs text-gray-400"><%= stats.totalOrders %> total orders</span>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      <%
        const pipeline = [
          { label:'Pending',   count: stats.pendingOrders,   cls:'pill-pending',   bg:'bg-amber-50',  icon:'⏳' },
          { label:'Confirmed', count: stats.confirmedOrders, cls:'pill-confirmed', bg:'bg-blue-50',   icon:'✓' },
          { label:'Shipped',   count: stats.shippedOrders,   cls:'pill-shipped',   bg:'bg-violet-50', icon:'🚚' },
          { label:'Delivered', count: stats.deliveredOrders, cls:'pill-delivered', bg:'bg-emerald-50',icon:'✅' },
          { label:'Cancelled', count: stats.cancelledOrders, cls:'pill-cancelled', bg:'bg-red-50',    icon:'✕' },
        ];
      %>
      <% pipeline.forEach(function(s){ %>
      <a href="/admin/orders?status=<%= s.label.toLowerCase() %>"
        class="<%= s.bg %> rounded-xl p-3.5 text-center hover:shadow-md transition-all group block">
        <p class="text-2xl font-bold text-gray-800 group-hover:scale-105 transition-transform inline-block"><%= s.count %></p>
        <p class="text-xs font-medium mt-1"><span class="<%= s.cls %> px-2 py-0.5 rounded-full"><%= s.label %></span></p>
        <% if(stats.totalOrders > 0){ %>
          <p class="text-xs text-gray-400 mt-1.5"><%= Math.round(s.count/stats.totalOrders*100) %>%</p>
        <% } %>
      </a>
      <% }); %>

      <!-- Fulfillment rate summary -->
      <div class="bg-slate-50 rounded-xl p-3.5 text-center border border-slate-200/80">
        <p class="text-2xl font-bold text-gray-800"><%= fulfillmentRate %>%</p>
        <p class="text-xs font-medium mt-1 text-slate-500">Fulfillment</p>
        <p class="text-xs text-gray-400 mt-1.5">Rate</p>
      </div>
    </div>
  </div>

  <!-- ── Row 3: Chart + Recent Orders ── -->
  <div class="grid grid-cols-1 lg:grid-cols-5 gap-5 mb-5">

    <!-- 7-day revenue chart -->
    <div class="lg:col-span-3 bg-white rounded-2xl ring-1 ring-black/5 shadow-sm p-5">
      <div class="flex items-center justify-between mb-1 gap-2">
        <h2 class="font-semibold text-gray-800 text-sm whitespace-nowrap">7-Day Revenue</h2>
        <span class="text-xs text-gray-400 bg-gray-50 px-2 py-1 rounded-lg whitespace-nowrap shrink-0" x-text="'Max ৳' + fmtK(chartMax)"></span>
      </div>

      <!-- Chart bars -->
      <div class="relative mt-4" style="height:160px">
        <!-- Grid lines -->
        <div class="absolute inset-0 flex flex-col justify-between pointer-events-none pb-6">
          <div class="h-px bg-gray-100 w-full"></div>
          <div class="h-px bg-gray-100 w-full"></div>
          <div class="h-px bg-gray-100 w-full"></div>
          <div class="h-px bg-gray-100 w-full"></div>
        </div>
        <!-- Empty state -->
        <div x-show="chartMax === 1" x-cloak
          class="absolute inset-0 flex flex-col items-center justify-center pb-6 text-gray-300">
          <svg class="w-8 h-8 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          <p class="text-sm text-gray-400 font-medium">No revenue data yet</p>
          <p class="text-xs text-gray-300 mt-0.5">Orders will appear here as they come in</p>
        </div>
        <!-- Bars area -->
        <div class="absolute inset-0 flex items-end gap-2 pb-6" x-show="chartMax > 1">
          <template x-for="(d, i) in chartData" :key="i">
            <div class="flex-1 flex flex-col items-center justify-end h-full group relative">
              <!-- Hover tooltip -->
              <div class="absolute bottom-full mb-2 left-1/2 -translate-x-1/2 hidden group-hover:block z-10 pointer-events-none">
                <div class="bg-gray-900 text-white text-xs rounded-lg px-2.5 py-1.5 whitespace-nowrap shadow-xl">
                  <p class="font-semibold" x-text="d.date"></p>
                  <p x-text="'৳ ' + d.revenue.toLocaleString()"></p>
                  <p class="text-gray-400" x-text="d.orders + ' orders'"></p>
                </div>
                <div class="w-2 h-2 bg-gray-900 rotate-45 mx-auto -mt-1"></div>
              </div>
              <!-- Bar -->
              <div class="w-full rounded-t-lg cursor-default transition-all group-hover:brightness-110"
                :style="`height:${barPct(d.revenue)}%; min-height:8px; background:linear-gradient(180deg,#fb7185 0%,#e11d48 100%)`">
              </div>
            </div>
          </template>
        </div>
        <!-- Day labels -->
        <div class="absolute bottom-0 inset-x-0 flex gap-2 h-5" x-show="chartMax > 1">
          <template x-for="(d, i) in chartData" :key="'l'+i">
            <span class="flex-1 text-center text-xs text-gray-400 leading-5 font-medium" x-text="d.date"></span>
          </template>
        </div>
      </div>

      <!-- Chart summary row -->
      <div class="grid grid-cols-3 gap-3 mt-4 pt-4 border-t border-gray-100">
        <div class="text-center">
          <p class="text-xs text-gray-400">7-day total</p>
          <p class="text-sm font-semibold text-gray-700 mt-0.5" x-text="'৳ ' + chart7DayTotal.toLocaleString()"></p>
        </div>
        <div class="text-center border-x border-gray-100">
          <p class="text-xs text-gray-400">Peak day</p>
          <p class="text-sm font-semibold text-gray-700 mt-0.5" x-text="chartPeakDay"></p>
        </div>
        <div class="text-center">
          <p class="text-xs text-gray-400">Avg/day</p>
          <p class="text-sm font-semibold text-gray-700 mt-0.5" x-text="'৳ ' + chartDailyAvg.toLocaleString()"></p>
        </div>
      </div>
    </div>

    <!-- Recent orders -->
    <div class="lg:col-span-2 bg-white rounded-2xl ring-1 ring-black/5 shadow-sm p-5 flex flex-col">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-semibold text-gray-800 text-sm">Recent Orders</h2>
        <a href="/admin/orders" class="text-xs text-rose-600 hover:text-rose-700 font-medium transition-colors">View all →</a>
      </div>
      <div class="space-y-1 overflow-y-auto flex-1" style="max-height:248px">
        <% stats.recentOrders.forEach(function(order){ %>
        <a href="/admin/orders/<%= order._id %>"
          class="flex items-center gap-3 px-2.5 py-2 rounded-xl hover:bg-gray-50 transition-colors group">
          <!-- Avatar -->
          <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center shrink-0 text-xs font-bold text-gray-500 group-hover:bg-rose-50 group-hover:text-rose-600 transition-colors">
            <%= order.customerName ? order.customerName.charAt(0).toUpperCase() : '?' %>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-gray-700 truncate"><%= order.orderNumber %></p>
            <p class="text-xs text-gray-400 truncate"><%= order.customerName %></p>
          </div>
          <div class="text-right shrink-0">
            <p class="text-xs font-semibold text-gray-700">৳ <%= order.total.toLocaleString() %></p>
            <span class="text-xs pill-<%= order.status %> px-1.5 py-0.5 rounded-full font-medium"><%= order.status %></span>
          </div>
        </a>
        <% }); %>
        <% if(!stats.recentOrders.length){ %>
          <div class="flex flex-col items-center justify-center py-10 text-gray-300">
            <svg class="w-10 h-10 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            <p class="text-sm">No orders yet</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- ── Row 4: Top Products + Quick Tools ── -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

    <!-- Top products -->
    <div class="bg-white rounded-2xl ring-1 ring-black/5 shadow-sm p-5">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-semibold text-gray-800 text-sm">Top Products</h2>
        <span class="text-xs text-gray-400">by qty sold</span>
      </div>
      <% if(stats.topProducts && stats.topProducts.length){ %>
        <% const maxQty = stats.topProducts[0].qty; %>
        <div class="space-y-4">
          <% stats.topProducts.forEach(function(p,i){ %>
          <div>
            <div class="flex items-center gap-2 mb-1.5">
              <span class="w-5 h-5 rounded-md bg-gray-100 text-gray-500 text-[10px] font-bold flex items-center justify-center shrink-0"><%= i+1 %></span>
              <span class="text-sm text-gray-700 font-medium flex-1 truncate"><%= p.name %></span>
              <span class="text-xs text-gray-400 shrink-0 font-medium"><%= p.qty %> pcs</span>
              <span class="text-xs font-semibold text-gray-600 shrink-0">৳ <%= p.revenue.toLocaleString() %></span>
            </div>
            <div class="h-1.5 bg-gray-100 rounded-full overflow-hidden">
              <div class="h-full rounded-full bg-gradient-to-r from-rose-400 to-rose-600 transition-all"
                style="width:<%= Math.round((p.qty/maxQty)*100) %>%"></div>
            </div>
          </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="flex flex-col items-center justify-center py-8 text-gray-300">
          <svg class="w-10 h-10 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          <p class="text-sm">No completed orders yet</p>
        </div>
      <% } %>

      <!-- Fulfillment summary footer -->
      <div class="mt-5 pt-4 border-t border-gray-100 grid grid-cols-2 gap-3">
        <div class="bg-emerald-50 rounded-xl p-3 text-center">
          <p class="text-lg font-bold text-emerald-700"><%= fulfillmentRate %>%</p>
          <p class="text-xs text-emerald-600">Fulfillment Rate</p>
        </div>
        <div class="bg-red-50 rounded-xl p-3 text-center">
          <p class="text-lg font-bold text-red-600"><%= cancellationRate %>%</p>
          <p class="text-xs text-red-500">Cancellation Rate</p>
        </div>
      </div>
    </div>

    <!-- Right column: S3 sync + Meta Pixel -->
    <div class="space-y-4">

      <!-- S3 Image Sync -->
      <div class="bg-white rounded-2xl ring-1 ring-black/5 shadow-sm p-5">
        <div class="flex items-start justify-between mb-3">
          <div class="flex items-center gap-3">
            <div class="stat-icon bg-indigo-50">
              <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-800">Image Storage Sync</p>
              <p class="text-xs text-gray-400 mt-0.5">Cache S3 images locally for fast serving</p>
            </div>
          </div>
          <% if(s3Configured){ %>
            <span class="text-xs pill-delivered px-2 py-0.5 rounded-full font-medium shrink-0">S3 on</span>
          <% } else { %>
            <span class="text-xs pill-inactive px-2 py-0.5 rounded-full font-medium shrink-0">Local</span>
          <% } %>
        </div>

        <button @click="syncS3()" :disabled="syncing || !<%= s3Configured %>"
          class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 disabled:bg-gray-100 disabled:text-gray-400 text-white text-sm font-medium px-4 py-2.5 rounded-xl transition-all w-full justify-center">
          <svg x-show="!syncing" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          <svg x-show="syncing" x-cloak class="w-4 h-4 shrink-0 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
          <span x-text="syncing ? 'Syncing images...' : 'Sync S3 → Local'"></span>
        </button>
        <% if(!s3Configured){ %>
          <p class="text-xs text-gray-400 mt-2 text-center">Set <code class="bg-gray-100 px-1 rounded">AWS_S3_BUCKET</code> in .env to enable</p>
        <% } %>

        <!-- Sync result -->
        <div x-show="syncResult" x-cloak class="mt-3 grid grid-cols-2 gap-2 text-xs">
          <div class="bg-gray-50 rounded-lg p-2.5 text-center">
            <p class="text-lg font-bold text-gray-700" x-text="syncResult?.total ?? 0"></p>
            <p class="text-gray-400">Found in S3</p>
          </div>
          <div class="bg-emerald-50 rounded-lg p-2.5 text-center">
            <p class="text-lg font-bold text-emerald-700" x-text="syncResult?.synced ?? 0"></p>
            <p class="text-emerald-600">Downloaded</p>
          </div>
          <div class="bg-gray-50 rounded-lg p-2.5 text-center">
            <p class="text-lg font-bold text-gray-600" x-text="syncResult?.alreadyLocal ?? 0"></p>
            <p class="text-gray-400">Already local</p>
          </div>
          <div :class="syncResult?.failed > 0 ? 'bg-red-50' : 'bg-gray-50'" class="rounded-lg p-2.5 text-center">
            <p :class="syncResult?.failed > 0 ? 'text-red-600' : 'text-gray-400'" class="text-lg font-bold" x-text="syncResult?.failed ?? 0"></p>
            <p :class="syncResult?.failed > 0 ? 'text-red-500' : 'text-gray-400'">Failed</p>
          </div>
        </div>
        <p x-show="syncError" x-cloak class="mt-2 text-xs text-red-500 bg-red-50 rounded-lg px-3 py-2" x-text="syncError"></p>
      </div>

      <!-- Meta Pixel -->
      <div class="bg-white rounded-2xl ring-1 ring-black/5 shadow-sm p-5">
        <div class="flex items-start justify-between mb-3">
          <div class="flex items-center gap-3">
            <div class="stat-icon bg-blue-50">
              <svg class="w-5 h-5 text-blue-600" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-800">Meta Pixel</p>
              <p class="text-xs text-gray-400 mt-0.5">Facebook / Instagram ads tracking</p>
            </div>
          </div>
          <% if(pixelConfigured){ %>
            <span class="inline-flex items-center gap-1.5 text-xs pill-delivered px-2 py-0.5 rounded-full font-medium shrink-0">
              <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>Active
            </span>
          <% } else { %>
            <span class="text-xs pill-inactive px-2 py-0.5 rounded-full font-medium shrink-0">Off</span>
          <% } %>
        </div>

        <% if(pixelConfigured){ %>
          <p class="text-xs text-gray-500 mb-2.5 font-medium">Tracked events:</p>
          <div class="flex flex-wrap gap-1.5 mb-3">
            <% ['PageView','ViewContent','AddToCart','InitiateCheckout','Purchase','Search'].forEach(function(ev){ %>
              <span class="text-xs bg-blue-50 text-blue-700 border border-blue-100 px-2.5 py-1 rounded-full font-medium"><%= ev %></span>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-xs text-gray-400 mb-3">Track conversions from Facebook and Instagram ads — add your Pixel ID in Settings.</p>
        <% } %>

        <a href="/admin/settings" class="inline-flex items-center gap-1.5 text-xs text-rose-600 hover:text-rose-700 font-medium transition-colors">
          <%= pixelConfigured ? 'Edit Pixel ID' : 'Configure Pixel' %>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

    </div>
  </div>

</div>

<script>
  const DASHBOARD_DATA = <%- JSON.stringify({ last7Days: stats.last7Days }) %>;
</script>

<%- include('partials/end') %>
