<%- include('partials/sidebar', { pageTitle: 'Orders' }) %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-bold text-gray-900">Orders</h1>
    <p class="text-sm text-gray-400 mt-0.5"><%= total %> total orders</p>
  </div>
  <a href="/admin/orders?status=pending"
    class="inline-flex items-center gap-2 text-sm font-medium bg-amber-50 hover:bg-amber-100 border border-amber-200 text-amber-800 px-3.5 py-2 rounded-xl transition-colors">
    <span class="w-1.5 h-1.5 bg-amber-500 rounded-full"></span>
    Pending first
  </a>
</div>

<!-- Status filter tabs -->
<div class="bg-white rounded-2xl ring-1 ring-black/5 shadow-sm overflow-hidden">
  <div class="flex gap-1 p-3 border-b border-gray-100 overflow-x-auto">
    <%
      const tabs = [
        { label: 'All', val: '', count: null },
        { label: 'Pending',   val: 'pending',   color: 'amber'  },
        { label: 'Confirmed', val: 'confirmed', color: 'blue'   },
        { label: 'Shipped',   val: 'shipped',   color: 'violet' },
        { label: 'Delivered', val: 'delivered', color: 'emerald'},
        { label: 'Cancelled', val: 'cancelled', color: 'red'    },
      ];
    %>
    <% tabs.forEach(function(t){ %>
      <a href="/admin/orders<%= t.val ? '?status='+t.val : '' %>"
        class="shrink-0 px-3.5 py-1.5 text-xs font-semibold
          <%= (!statusFilter && !t.val) || statusFilter === t.val
            ? (t.val ? 'pill-'+t.val+' shadow-sm rounded-lg' : 'bg-gray-900 text-white rounded-lg')
            : 'tab-inactive' %>">
        <%= t.label %>
      </a>
    <% }); %>
  </div>

  <!-- Table -->
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-100">
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Order</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Customer</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide hidden md:table-cell">Phone</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Amount</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Status</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide hidden sm:table-cell">Date</th>
          <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wide">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <% orders.forEach(function(order){ %>
        <tr class="hover:bg-slate-50/60 transition-colors <%= order.status==='pending' ? 'bg-amber-50/30' : '' %>">
          <td class="px-4 py-3.5">
            <span class="font-mono text-xs font-semibold text-gray-700"><%= order.orderNumber %></span>
          </td>
          <td class="px-4 py-3.5">
            <div class="flex items-center gap-2.5">
              <div class="w-7 h-7 rounded-full bg-gray-100 flex items-center justify-center text-xs font-bold text-gray-500 shrink-0">
                <%= order.customerName ? order.customerName.charAt(0).toUpperCase() : '?' %>
              </div>
              <span class="font-medium text-gray-700 text-sm"><%= order.customerName %></span>
            </div>
          </td>
          <td class="px-4 py-3.5 text-gray-500 hidden md:table-cell text-xs"><%= order.customerPhone %></td>
          <td class="px-4 py-3.5">
            <span class="font-semibold text-gray-800">৳ <%= order.total.toLocaleString() %></span>
            <span class="text-xs text-gray-400 block"><%= order.items ? order.items.length : 0 %> item<%= order.items && order.items.length !== 1 ? 's' : '' %></span>
          </td>
          <td class="px-4 py-3.5">
            <span class="text-xs pill-<%= order.status %> px-2.5 py-1 rounded-full font-semibold">
              <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
            </span>
          </td>
          <td class="px-4 py-3.5 text-gray-400 text-xs hidden sm:table-cell">
            <% const d = new Date(order.createdAt); %>
            <span class="block"><%= d.toLocaleDateString('en-GB', {day:'2-digit',month:'short',year:'numeric'}) %></span>
            <span class="text-gray-300"><%= d.toLocaleTimeString('en-US', {hour:'2-digit',minute:'2-digit'}) %></span>
          </td>
          <td class="px-4 py-3.5 text-right">
            <a href="/admin/orders/<%= order._id %>"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-rose-600 hover:text-rose-700 bg-rose-50 hover:bg-rose-100 px-3 py-1.5 rounded-lg transition-colors">
              View
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </td>
        </tr>
        <% }); %>
        <% if(!orders.length){ %>
        <tr>
          <td colspan="7" class="px-4 py-16 text-center">
            <div class="flex flex-col items-center gap-3 text-gray-300">
              <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
              <p class="text-sm font-medium text-gray-400">No orders found</p>
            </div>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if(pages > 1){ %>
  <div class="flex items-center justify-between px-4 py-3 border-t border-gray-100">
    <p class="text-xs text-gray-400">Page <%= page %> of <%= pages %></p>
    <div class="flex gap-1">
      <% if(page > 1){ %>
        <a href="/admin/orders?page=<%= page-1 %><%= statusFilter ? '&status='+statusFilter : '' %>"
          class="px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-100 hover:bg-gray-200 text-gray-600 transition-colors">← Prev</a>
      <% } %>
      <% for(let i=Math.max(1,page-2); i<=Math.min(pages,page+2); i++){ %>
        <a href="/admin/orders?page=<%= i %><%= statusFilter ? '&status='+statusFilter : '' %>"
          class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors
            <%= i===page ? 'bg-rose-600 text-white shadow-sm' : 'bg-gray-100 hover:bg-gray-200 text-gray-600' %>"><%= i %></a>
      <% } %>
      <% if(page < pages){ %>
        <a href="/admin/orders?page=<%= page+1 %><%= statusFilter ? '&status='+statusFilter : '' %>"
          class="px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-100 hover:bg-gray-200 text-gray-600 transition-colors">Next →</a>
      <% } %>
    </div>
  </div>
  <% } %>
</div>

<%- include('partials/end') %>
